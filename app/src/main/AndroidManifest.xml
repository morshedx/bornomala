<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy-first: NO android.permission.INTERNET (or any network permission) is
      declared in V1. Vibration is used for optional key-press haptics, which does not
      involve any data collection.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BornomalaApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bornomala">

        <!-- Allows performance profiling (macrobenchmark). No effect on normal use. -->
        <profileable android:shell="true" tools:targetApi="q" />

        <!--
          The Input Method (keyboard) service. The implementation lives in the
          :keyboard module (com.bornomala.keyboard.ime.KeyboardImeService) and is
          wired into the DI graph rooted in this module.
        -->
        <service
            android:name="com.bornomala.keyboard.ime.KeyboardImeService"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Launcher entry point: the step-by-step activation flow (Gboard-style). It routes
             to settings once the keyboard is enabled and selected. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bornomala">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings screen: opened from onboarding and from the keyboard (long-press comma). -->
        <activity
            android:name="com.bornomala.keyboard.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bornomala"
            android:windowSoftInputMode="adjustResize"
            tools:replace="android:exported" />
    </application>

</manifest>
