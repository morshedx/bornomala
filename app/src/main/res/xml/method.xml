<?xml version="1.0" encoding="utf-8"?>
<!--
  IME subtype declaration. Two subtypes are exposed so the system language switcher and
  the keyboard's own language key can move between English (QWERTY) and Bangla (Avro
  phonetic). Each subtype's visible name is forced via UntranslatableReplacementInSubtypeName
  (with the "%s" name template) so it reads e.g. "English (US)" / "বাংলা (বাংলাদেশ)" rather
  than the long system locale name.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.bornomala.keyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:name="@string/subtype_label"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="UntranslatableReplacementInSubtypeName=English (US),layout=qwerty" />

    <subtype
        android:name="@string/subtype_label"
        android:imeSubtypeLocale="bn_BD"
        android:languageTag="bn-BD"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="UntranslatableReplacementInSubtypeName=বাংলা (বাংলাদেশ),layout=avro_phonetic" />

</input-method>
