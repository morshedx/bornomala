<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the teal field behind the Bangla "অ", as a radial gradient
     (slightly lighter center) to match the supplied icon art. Drawn as a shape so it stays
     crisp at every density with no raster assets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:startColor="#11655B"
        android:endColor="#0B4A44"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="72dp" />
</shape>
