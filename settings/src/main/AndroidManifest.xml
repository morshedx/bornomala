<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          Settings launcher activity. The launcher <activity> entry (intent-filter with
          MAIN/LAUNCHER) is declared by the :app manifest which references this class;
          here we only contribute the component so the class is resolvable from the
          merged manifest. Theme is applied by Compose (BornomalaTheme) at runtime.
        -->
        <activity
            android:name="com.bornomala.keyboard.settings.SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
